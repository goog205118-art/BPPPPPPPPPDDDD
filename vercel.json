{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "api/[...route].mjs",
      "use": "@vercel/node"
    },
    {
      "src": "app/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/[...route].mjs"
    },
    {
      "src": "/",
      "dest": "/app/index.html"
    },
    {
      "src": "/index.html",
      "dest": "/app/index.html"
    },
    {
      "src": "/styles.css",
      "dest": "/app/styles.css"
    },
    {
      "src": "/app.js",
      "dest": "/app/app.js"
    },
    {
      "src": "/favicon.png",
      "dest": "/app/favicon.png"
    }
  ]
}
