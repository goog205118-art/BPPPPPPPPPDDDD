# Required for the online application.
WORKBENCH_ACCESS_PASSWORD=replace-with-a-strong-private-password
BLOB_READ_WRITE_TOKEN=vercel_blob_read_write_token

# Optional server-side AI key fallback. These are used when a profile chooses
# "environment" as its key source. Do not put real values in GitHub.
RESOURCE_WORKBENCH_CREATOR_AI_KEY=
RESOURCE_WORKBENCH_LEAD_AI_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
